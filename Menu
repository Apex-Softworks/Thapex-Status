-- Home Section
local MovementSection = HomeTab:CreateSection({ name = "Movement"})

local jumpConnection = nil

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoidRootPart = character:WaitForChild("HumanoidRootPart")
local humanoid = character:WaitForChild("Humanoid")

local flying = false
local flySpeed = 50

local bodyVelocity, bodyGyro
local moveConnection

local function startFly()
    if flying then return end
    flying = true

    bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bodyVelocity.Velocity = Vector3.new(0, 0, 0)
    bodyVelocity.Parent = humanoidRootPart

    bodyGyro = Instance.new("BodyGyro")
    bodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bodyGyro.CFrame = humanoidRootPart.CFrame
    bodyGyro.Parent = humanoidRootPart

    humanoid.PlatformStand = true

    moveConnection = RunService.RenderStepped:Connect(function()
        local camera = workspace.CurrentCamera
        local moveVector = Vector3.new(0, 0, 0)

        if UserInputService:IsKeyDown(Enum.KeyCode.W) then
            moveVector = moveVector + camera.CFrame.LookVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then
            moveVector = moveVector - camera.CFrame.LookVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then
            moveVector = moveVector - camera.CFrame.RightVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then
            moveVector = moveVector + camera.CFrame.RightVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
            moveVector = moveVector + Vector3.new(0, 1, 0)
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
            moveVector = moveVector - Vector3.new(0, 1, 0)
        end

        if moveVector.Magnitude > 0 then
            moveVector = moveVector.Unit * flySpeed
        end

        bodyVelocity.Velocity = moveVector
        bodyGyro.CFrame = camera.CFrame
    end)
end

local function stopFly()
    if not flying then return end
    flying = false

    if moveConnection then
        moveConnection:Disconnect()
        moveConnection = nil
    end

    if bodyVelocity then bodyVelocity:Destroy() end
    if bodyGyro then bodyGyro:Destroy() end

    humanoid.PlatformStand = false
end

-- Charakter-Reset behandeln
player.CharacterAdded:Connect(function(newCharacter)
    character = newCharacter
    humanoidRootPart = character:WaitForChild("HumanoidRootPart")
    humanoid = character:WaitForChild("Humanoid")
    flying = false
end)

local Jump = HomeTab:CreateToggle({
    name = "Infinity Jump",
    flag = "InfinityJump",
    value = false,
    callback = function(value)
        if value then
            -- Nur verbinden, wenn noch keine Connection existiert
            if not jumpConnection then
                jumpConnection = game:GetService("UserInputService").JumpRequest:Connect(function()
                    local character = game:GetService("Players").LocalPlayer.Character
                    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
                    if humanoid then
                        humanoid:ChangeState("Jumping")
                    end
                end)
            end
        else
            -- Connection sauber trennen
            if jumpConnection then
                jumpConnection:Disconnect()
                jumpConnection = nil
            end
        end
    end,
})
Jump:Set(false)

local Fly = HomeTab:CreateToggle({
    name = "Fly",
    flag = "fly",
    value = true,
    callback = function(value)
        if value then 
            startFly()
        else 
            stopFly()
        end
    end,
})
Fly:Set(false)

